# === Course V4 personal site — copy to .env (never commit .env) ===

# Slug ที่วิทยากรแจก (user01..user30)
STUDENT_SLUG=user01

# URL จริงหลัง Ship (Lab 08)
SITE_URL=https://user01.9expert.online

# Dev
HOST=127.0.0.1
PORT=4321
DATA_DIR=./data

# Rate limiting (Lab 05/08): set to "true" only when a trusted reverse proxy
# (Coolify/Traefik) sits in front and appends the real client IP as the
# right-most entry of X-Forwarded-For. Leave unset/false for local dev, where
# clientAddress already reflects the real connection.
TRUST_PROXY=false

# GitHub MCP — fine-grained PAT จำกัดเฉพาะ repo ของคุณ (Issues + PRs)
# สร้างที่ https://github.com/settings/personal-access-tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Claude Code Agent Teams (optional Lab 02) — Windows ใช้ in-process ไม่บังคับ tmux
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Coolify deploy webhook (Lab 08 — วิทยากรแจกต่อคน หรือสร้าง app เอง)
# COOLIFY_DEPLOY_WEBHOOK=
