---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="สมุดเยี่ยม">
  <section class="card">
    <h1>สมุดเยี่ยม</h1>
    <p>ฝากคำทักทายถึงผมได้ครับ</p>
    <form id="gb-form">
      <label for="name">ชื่อ</label>
      <input id="name" name="name" required maxlength="80" />
      <label for="message">ข้อความ</label>
      <textarea id="message" name="message" rows="3" required maxlength="500"></textarea>
      <p style="margin-top:1rem"><button type="submit">ส่งข้อความ</button></p>
      <p id="gb-status" role="status" aria-live="polite"></p>
    </form>
    <div id="entries" aria-live="polite">กำลังโหลด…</div>
  </section>
</BaseLayout>
<script>
  // ข้อมูลจากผู้ใช้ต้องแสดงผ่าน textContent เท่านั้น — ห้าม innerHTML (D6 · #5)
  // ไม่แสดง error ดิบจาก API (D11)
  const entries = document.getElementById('entries') as HTMLElement;
  const form = document.getElementById('gb-form') as HTMLFormElement;
  const status = document.getElementById('gb-status') as HTMLElement;
  const CLOSED = 'สมุดเยี่ยมยังไม่เปิดให้เขียนครับ';

  function entryNode(e: { name?: string; message?: string; created_at?: string }) {
    const p = document.createElement('p');
    const name = document.createElement('strong');
    name.textContent = e.name ?? '';
    p.append(name, `: ${e.message ?? ''}`);
    if (e.created_at) {
      const time = document.createElement('small');
      time.textContent = e.created_at;
      p.append(document.createElement('br'), time);
    }
    return p;
  }

  async function load() {
    try {
      const res = await fetch('/api/guestbook');
      if (!res.ok) {
        entries.textContent = res.status === 501 ? CLOSED : 'โหลดข้อความไม่สำเร็จ ลองใหม่อีกครั้ง';
        return;
      }
      const data = await res.json();
      const list: { name?: string; message?: string; created_at?: string }[] = data.entries || [];
      if (!list.length) {
        entries.textContent = 'ยังไม่มีข้อความ';
        return;
      }
      entries.replaceChildren(...list.map(entryNode));
    } catch {
      entries.textContent = 'โหลดข้อความไม่สำเร็จ ลองใหม่อีกครั้ง';
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    status.textContent = 'กำลังส่ง…';
    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        status.textContent = 'ขอบคุณครับ';
        form.reset();
        await load();
      } else if (res.status === 501) {
        status.textContent = CLOSED;
      } else if (res.status === 429) {
        status.textContent = 'ส่งถี่เกินไป รอสักครู่แล้วลองใหม่ครับ';
      } else {
        status.textContent = 'ส่งไม่สำเร็จ ลองใหม่อีกครั้ง';
      }
    } catch {
      status.textContent = 'ส่งไม่สำเร็จ ลองใหม่อีกครั้ง';
    }
  });

  load();
</script>
