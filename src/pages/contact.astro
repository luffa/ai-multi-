---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
// v1 ติดต่อผ่าน GitHub อย่างเดียว (D3) · ฟอร์มกลับมาเมื่อ API ผ่านเงื่อนไขใน DECISIONS (L11)
---
<BaseLayout title={`ติดต่อ · ${profile.name}`}>
  <section class="card">
    <h1>ติดต่อ</h1>
    {profile.github ? (
      <>
        <p>ตอนนี้ติดต่อผมได้ทาง GitHub ครับ</p>
        <p class="actions"><a class="button primary" href={profile.github} rel="noopener noreferrer">ไปที่ GitHub</a></p>
      </>
    ) : (
      <p>ช่องทางติดต่อกำลังจะเปิดเร็ว ๆ นี้ครับ</p>
    )}
  </section>
</BaseLayout>
