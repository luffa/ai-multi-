---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
// หน้าแรกโชว์แค่ย่อหน้าแรกของ Bio · ฉบับเต็มอยู่หน้า About (D7 / #2)
const intro = profile.bio.split(/\n{2,}/)[0];
---
<BaseLayout title={`${profile.name} · หน้าแรก`} description={profile.tagline || profile.headline}>
  <section class="card">
    <h1>{profile.name}</h1>
    <p style="font-size:1.2rem;color:var(--text);margin-bottom:0.25rem">{profile.headline}</p>
    {profile.tagline && <p style="color:var(--accent);font-weight:700;margin-top:0">{profile.tagline}</p>}
    <p>{intro}</p>
    <p class="actions">
      {profile.github && <a class="button primary" href={profile.github} rel="noopener noreferrer">ดู GitHub</a>}
      <a class="button" href="/contact">ติดต่อผม</a>
    </p>
  </section>
  <section class="grid">
    <a class="card" href="/about"><h2>เกี่ยวกับผม</h2><p>เส้นทางและงานที่ผมดูแล</p></a>
    <a class="card" href="/interests"><h2>เทคโนโลยีที่ใช้</h2><p>ฐานข้อมูล · แอปพลิเคชัน · เซิร์ฟเวอร์</p></a>
    <a class="card" href="/contact"><h2>ติดต่อ</h2><p>ช่องทางคุยกับผม</p></a>
  </section>
</BaseLayout>
